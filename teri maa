<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>For You</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(-45deg, #ff9a9e, #fad0c4, #fbc2eb, #a18cd1);
    background-size: 400% 400%;
    animation: gradientShift 12s ease infinite;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"><path fill="%23ff4d6d" d="M12 21s-6.7-4.35-9.3-8.28C1.02 10.36 1.4 7.4 3.6 5.6c2-1.64 4.82-1.3 6.4.5L12 8.2l2-2.1c1.58-1.8 4.4-2.14 6.4-.5 2.2 1.8 2.58 4.76.9 7.12C18.7 16.65 12 21 12 21z"/></svg>') 14 12, auto;
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .heart {
    position: absolute;
    bottom: -50px;
    font-size: 24px;
    opacity: 0.7;
    animation: floatUp linear infinite;
    user-select: none;
    pointer-events: none;
    z-index: 1;
  }

  @keyframes floatUp {
    0% { transform: translateY(0) rotate(0deg); opacity: 0.8; }
    100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
  }

  .card {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-radius: 24px;
    padding: 50px 40px;
    max-width: 420px;
    width: 90%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    z-index: 10;
    animation: popIn 0.6s ease;
  }

  @keyframes popIn {
    0% { transform: scale(0.85); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .question {
    font-size: 25px;
    color: #6b2c5f;
    margin-bottom: 28px;
    font-weight: 600;
    line-height: 1.4;
  }

  input[type="date"] {
    width: 100%;
    padding: 14px 16px;
    font-size: 17px;
    border-radius: 14px;
    border: 2px solid #ffb6c1;
    outline: none;
    color: #6b2c5f;
    font-weight: 600;
    background: #fff;
    margin-bottom: 22px;
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"><path fill="%23ff4d6d" d="M12 21s-6.7-4.35-9.3-8.28C1.02 10.36 1.4 7.4 3.6 5.6c2-1.64 4.82-1.3 6.4.5L12 8.2l2-2.1c1.58-1.8 4.4-2.14 6.4-.5 2.2 1.8 2.58 4.76.9 7.12C18.7 16.65 12 21 12 21z"/></svg>') 14 12, auto;
  }

  input[type="date"]:focus {
    border-color: #ff6a88;
  }

  button {
    border: none;
    padding: 14px 34px;
    font-size: 17px;
    border-radius: 50px;
    font-weight: 600;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"><path fill="%23ff4d6d" d="M12 21s-6.7-4.35-9.3-8.28C1.02 10.36 1.4 7.4 3.6 5.6c2-1.64 4.82-1.3 6.4.5L12 8.2l2-2.1c1.58-1.8 4.4-2.14 6.4-.5 2.2 1.8 2.58 4.76.9 7.12C18.7 16.65 12 21 12 21z"/></svg>') 14 12, pointer;
  }

  .submit-btn {
    background: linear-gradient(135deg, #ff6a88, #ff99ac);
    color: white;
    box-shadow: 0 8px 20px rgba(255, 106, 136, 0.4);
    width: 100%;
  }

  .submit-btn:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 12px 26px rgba(255, 106, 136, 0.55);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: default;
    transform: none;
  }

  .subtext {
    margin-top: 16px;
    font-size: 14px;
    color: #a15a8f;
    opacity: 0.85;
  }

  .thankyou {
    display: none;
    flex-direction: column;
    align-items: center;
  }

  .thankyou.active {
    display: flex;
  }

  .form-view {
    display: flex;
    flex-direction: column;
  }

  .form-view.hidden {
    display: none;
  }

  .big-heart {
    font-size: 55px;
    animation: pulseHeart 1s ease infinite;
    margin-bottom: 10px;
  }

  @keyframes pulseHeart {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  .error-msg {
    color: #d9436b;
    font-size: 13px;
    margin-top: -12px;
    margin-bottom: 14px;
    display: none;
  }
</style>
</head>
<body>

  <div class="card">

    <div class="form-view" id="formView">
      <div class="question">When are we going on a date? 📅</div>
      <input type="date" id="dateInput" />
      <div class="error-msg" id="errorMsg">Pick a date first 🥺</div>
      <button class="submit-btn" id="submitBtn" onclick="submitDate()">Confirm this date</button>
      <div class="subtext">I'll be counting down the days 💕</div>
    </div>

    <div class="thankyou" id="thankYouView">
      <div class="big-heart">💖</div>
      <div class="question" id="thankYouText">It's set. Can't wait! 🥰</div>
      <div class="subtext">I'll be counting down the days until then.</div>
    </div>

  </div>

<script>
  const FORM_ENDPOINT = "https://formspree.io/f/moeqjayw";

  const dateInput = document.getElementById("dateInput");
  const submitBtn = document.getElementById("submitBtn");
  const errorMsg = document.getElementById("errorMsg");
  const formView = document.getElementById("formView");
  const thankYouView = document.getElementById("thankYouView");
  const thankYouText = document.getElementById("thankYouText");

  const today = new Date().toISOString().split("T")[0];
  dateInput.setAttribute("min", today);

  async function submitDate() {
    const chosenDate = dateInput.value;

    if (!chosenDate) {
      errorMsg.style.display = "block";
      return;
    }
    errorMsg.style.display = "none";

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";

    try {
      const response = await fetch(FORM_ENDPOINT, {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ chosen_date: chosenDate })
      });

      if (response.ok) {
        const formatted = new Date(chosenDate + "T00:00:00").toLocaleDateString(undefined, {
          weekday: "long", year: "numeric", month: "long", day: "numeric"
        });
        thankYouText.textContent = "It's set for " + formatted + "! 🥰";
        formView.classList.add("hidden");
        thankYouView.classList.add("active");
      } else {
        submitBtn.disabled = false;
        submitBtn.textContent = "Confirm this date";
        errorMsg.textContent = "Hmm, something went wrong. Try again?";
        errorMsg.style.display = "block";
      }
    } catch (err) {
      submitBtn.disabled = false;
      submitBtn.textContent = "Confirm this date";
      errorMsg.textContent = "Hmm, something went wrong. Try again?";
      errorMsg.style.display = "block";
    }
  }

  function createHeart() {
    const heart = document.createElement("div");
    heart.classList.add("heart");
    heart.textContent = ["💗", "💖", "💕", "❤️", "💓"][Math.floor(Math.random() * 5)];
    heart.style.left = Math.random() * 100 + "vw";
    heart.style.fontSize = (16 + Math.random() * 20) + "px";
    heart.style.animationDuration = (6 + Math.random() * 6) + "s";
    document.body.appendChild(heart);
    setTimeout(() => heart.remove(), 13000);
  }
  setInterval(createHeart, 700);
</script>

</body>
</html>
